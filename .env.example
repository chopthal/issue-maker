# ==========================================
# Issue-Maker 환경 설정 (.env)
# ==========================================

# 1. 텔레그램 봇 토큰 (필수)
# @BotFather 에게서 발급받은 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (선택) 특정 채팅방/그룹 ID만 허용할 경우 (콤마로 구분, 비워두면 모든 채팅방 허용)
# ALLOWED_CHAT_IDS=123456789,-100987654321

# 2. GitHub 연동 설정
# GitHub Personal Access Token (classic: repo 권한 또는 fine-grained: Issues read/write)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name

# 3. AI 워커 설정 (One-Shot 단일 엔진)
# -------------------------------------------------------------
# 지원 엔진: 'agy' | 'cursor' | 'openai'
#
# [옵션 1 (기본 추천: agy Gemini 3.8 Flash - 초고속 무료)]
#   WORKER_ENGINE=agy
#   WORKER_MODEL=gemini-3.8-flash-low
#
# [옵션 2: Cursor 에이전트 Auto / Luna]
#   WORKER_ENGINE=cursor
#   WORKER_MODEL=auto (또는 gpt-5.6-luna-medium)
#
# [옵션 3: OpenAI 공식 API]
#   WORKER_ENGINE=openai
#   WORKER_MODEL=gpt-6-luna
#   OPENAI_API_KEY=sk-...
# -------------------------------------------------------------
WORKER_ENGINE=agy
WORKER_MODEL=gemini-3.8-flash-low
WORKER_MODE=plan
